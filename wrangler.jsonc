{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker (Cloudflare's successor to Pages): no server code.
  "name": "rushiltech",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "rushiltech.in", "custom_domain": true }]
}
